# Metin dosyaları depoda LF, Windows'ta checkout'ta CRLF'e çevrilmez (tutarlı diff için)
* text=auto eol=lf

# Windows betikleri CRLF kalmalı
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

